      "label": "Ime i prezime kandidata",
      "validate": {
        "required": true
      }
    },
    {
      "type": "number",
      "id": "Field_002",
      "key": "technicalKnowledge",
      "label": "Tehničko znanje (1-5)",
      "validate": {
        "required": true
      }
    },
    {
      "type": "number",
      "id": "Field_003",
      "key": "problemSolving",
      "label": "Rješavanje problema (1-5)",
      "validate": {
        "required": true
      }
    },
    {
      "type": "number",
      "id": "Field_004",
      "key": "communication",
      "label": "Komunikacija (1-5)",
      "validate": {
        "required": true
      }
    },
    {
      "type": "textfield",
      "id": "Field_005",
      "key": "recommendation",
      "label": "Preporuka",
      "validate": {
        "required": true
      }
    },
    {
      "type": "textarea",
      "id": "Field_006",
