<?xml version="1.0" encoding="UTF-8"?>
<definitions
  xmlns="http://www.omg.org/spec/DMN/20151101/dmn.xsd"
  xmlns:dmndi="http://www.omg.org/spec/DMN/20151101/DMNDI.xsd"
  xmlns:di="http://www.omg.org/spec/DMN/20151101/DI.xsd"
  xmlns:dc="http://www.omg.org/spec/DMN/20151101/DC.xsd"
  id="Definitions_JGL_IT_Hire_Decisions"
  name="JGL IT Hire Decisions (PDF aligned)"
  namespace="http://jgl.hr/dmn/it-hire">

  <!-- ===================== Input Data ===================== -->
  <inputData id="Input_roleType" name="roleType">
    <variable name="roleType" typeRef="string"/>
  </inputData>

  <inputData id="Input_hrScreeningPassed" name="hrScreeningPassed">
    <variable name="hrScreeningPassed" typeRef="boolean"/>
  </inputData>

  <inputData id="Input_technicalTestScore" name="technicalTestScore">
    <variable name="technicalTestScore" typeRef="integer"/>
  </inputData>

  <inputData id="Input_technicalInterviewScore" name="technicalInterviewScore">
    <variable name="technicalInterviewScore" typeRef="integer"/>
  </inputData>

  <inputData id="Input_referenceCheckPassed" name="referenceCheckPassed">
    <variable name="referenceCheckPassed" typeRef="boolean"/>
  </inputData>

  <inputData id="Input_seniority" name="seniority">
    <variable name="seniority" typeRef="string"/>
  </inputData>

  <!-- =========================================================
       Decision 1: Evaluate Candidate
       Kriteriji iz PDF-a: HR screening + tehnički test + tehnički intervju + reference.
       Napomena: PDF ne daje numeričke pragove, pa su pragovi formalizirani po ulozi.
       roleType vrijednosti: "helpdesk" | "programer" | "noc_soc"
       ========================================================= -->
  <decision id="Decision_EvaluateCandidate" name="Evaluate Candidate">
    <informationRequirement id="IR_EC_roleType">
      <requiredInput href="#Input_roleType"/>
    </informationRequirement>
    <informationRequirement id="IR_EC_hr">
      <requiredInput href="#Input_hrScreeningPassed"/>
    </informationRequirement>
    <informationRequirement id="IR_EC_test">
      <requiredInput href="#Input_technicalTestScore"/>
    </informationRequirement>
    <informationRequirement id="IR_EC_interview">
      <requiredInput href="#Input_technicalInterviewScore"/>
    </informationRequirement>
    <informationRequirement id="IR_EC_ref">
      <requiredInput href="#Input_referenceCheckPassed"/>
    </informationRequirement>
    <informationRequirement id="IR_EC_seniority">
      <requiredInput href="#Input_seniority"/>
    </informationRequirement>

    <decisionTable id="DT_EvaluateCandidate" hitPolicy="FIRST">
      <input id="DT_EC_In1">
        <inputExpression id="DT_EC_InExpr1" typeRef="string">
          <text>roleType</text>
        </inputExpression>
      </input>
      <input id="DT_EC_In2">
        <inputExpression id="DT_EC_InExpr2" typeRef="boolean">
          <text>hrScreeningPassed</text>
        </inputExpression>
      </input>
      <input id="DT_EC_In3">
        <inputExpression id="DT_EC_InExpr3" typeRef="integer">
          <text>technicalTestScore</text>
        </inputExpression>
      </input>
      <input id="DT_EC_In4">
        <inputExpression id="DT_EC_InExpr4" typeRef="integer">
          <text>technicalInterviewScore</text>
        </inputExpression>
      </input>
      <input id="DT_EC_In5">
        <inputExpression id="DT_EC_InExpr5" typeRef="boolean">
          <text>referenceCheckPassed</text>
        </inputExpression>
      </input>
      <input id="DT_EC_In6">
        <inputExpression id="DT_EC_InExpr6" typeRef="string">
          <text>seniority</text>
        </inputExpression>
      </input>

      <output id="DT_EC_Out1" name="result" typeRef="string"/>
      <output id="DT_EC_Out2" name="needsFinalInterview" typeRef="boolean"/>

      <!-- Helpdesk -->
      <rule id="R_EC_Helpdesk_Offer">
        <inputEntry id="R_EC_Helpdesk_Offer_i1"><text>"helpdesk"</text></inputEntry>
        <inputEntry id="R_EC_Helpdesk_Offer_i2"><text>true</text></inputEntry>
        <inputEntry id="R_EC_Helpdesk_Offer_i3"><text>&gt;= 60</text></inputEntry>
        <inputEntry id="R_EC_Helpdesk_Offer_i4"><text>&gt;= 65</text></inputEntry>
        <inputEntry id="R_EC_Helpdesk_Offer_i5"><text>true</text></inputEntry>
        <inputEntry id="R_EC_Helpdesk_Offer_i6"><text>-</text></inputEntry>
        <outputEntry id="R_EC_Helpdesk_Offer_o1"><text>"Offer"</text></outputEntry>
        <outputEntry id="R_EC_Helpdesk_Offer_o2"><text>false</text></outputEntry>
      </rule>

      <!-- Programer -->
      <rule id="R_EC_Dev_Offer">
        <inputEntry id="R_EC_Dev_Offer_i1"><text>"programer"</text></inputEntry>
        <inputEntry id="R_EC_Dev_Offer_i2"><text>true</text></inputEntry>
        <inputEntry id="R_EC_Dev_Offer_i3"><text>&gt;= 75</text></inputEntry>
        <inputEntry id="R_EC_Dev_Offer_i4"><text>&gt;= 75</text></inputEntry>
        <inputEntry id="R_EC_Dev_Offer_i5"><text>true</text></inputEntry>
        <inputEntry id="R_EC_Dev_Offer_i6"><text>-</text></inputEntry>
        <outputEntry id="R_EC_Dev_Offer_o1"><text>"Offer"</text></outputEntry>
        <outputEntry id="R_EC_Dev_Offer_o2"><text>seniority = "senior"</text></outputEntry>
      </rule>

      <!-- NOC/SOC -->
      <rule id="R_EC_NocSoc_Offer">
        <inputEntry id="R_EC_NocSoc_Offer_i1"><text>"noc_soc"</text></inputEntry>
        <inputEntry id="R_EC_NocSoc_Offer_i2"><text>true</text></inputEntry>
        <inputEntry id="R_EC_NocSoc_Offer_i3"><text>&gt;= 70</text></inputEntry>
        <inputEntry id="R_EC_NocSoc_Offer_i4"><text>&gt;= 75</text></inputEntry>
        <inputEntry id="R_EC_NocSoc_Offer_i5"><text>true</text></inputEntry>
        <inputEntry id="R_EC_NocSoc_Offer_i6"><text>-</text></inputEntry>
        <outputEntry id="R_EC_NocSoc_Offer_o1"><text>"Offer"</text></outputEntry>
        <outputEntry id="R_EC_NocSoc_Offer_o2"><text>seniority = "senior"</text></outputEntry>
      </rule>

      <!-- fallback -->
      <rule id="R_EC_Reject">
        <inputEntry id="R_EC_Reject_i1"><text>-</text></inputEntry>
        <inputEntry id="R_EC_Reject_i2"><text>-</text></inputEntry>
        <inputEntry id="R_EC_Reject_i3"><text>-</text></inputEntry>
        <inputEntry id="R_EC_Reject_i4"><text>-</text></inputEntry>
        <inputEntry id="R_EC_Reject_i5"><text>-</text></inputEntry>
        <inputEntry id="R_EC_Reject_i6"><text>-</text></inputEntry>
        <outputEntry id="R_EC_Reject_o1"><text>"Reject"</text></outputEntry>
        <outputEntry id="R_EC_Reject_o2"><text>false</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>

  <!-- =========================================================
       Decision 2: Equipment Profile
       Usklađeno s tablicom opreme po pozicijama iz PDF-a:
       - Helpdesk: standardni laptop + 2 monitora + remote/ticketing alati
       - Programer: jači laptop + 3 monitora + IDE/dev alati
       - NOC/SOC: workstation/laptop + 4 monitora + SIEM/monitoring alati (viši security)
       ========================================================= -->
  <decision id="Decision_EquipmentProfile" name="Equipment Profile">
    <informationRequirement id="IR_EP_roleType">
      <requiredInput href="#Input_roleType"/>
    </informationRequirement>

    <decisionTable id="DT_EquipmentProfile" hitPolicy="FIRST">
      <input id="DT_EP_In1">
        <inputExpression id="DT_EP_InExpr1" typeRef="string">
          <text>roleType</text>
        </inputExpression>
      </input>

      <output id="DT_EP_Out1" name="hardwarePackage" typeRef="string"/>
      <output id="DT_EP_Out2" name="monitorCount" typeRef="integer"/>
      <output id="DT_EP_Out3" name="peripherals" typeRef="string"/>
      <output id="DT_EP_Out4" name="softwarePackage" typeRef="string"/>
      <output id="DT_EP_Out5" name="securityLevel" typeRef="string"/>

      <rule id="R_EP_Helpdesk">
        <inputEntry id="R_EP_Helpdesk_i1"><text>"helpdesk"</text></inputEntry>
        <outputEntry id="R_EP_Helpdesk_o1"><text>"Laptop (standard/srednja klasa)"</text></outputEntry>
        <outputEntry id="R_EP_Helpdesk_o2"><text>2</text></outputEntry>
        <outputEntry id="R_EP_Helpdesk_o3"><text>"Docking; headset"</text></outputEntry>
        <outputEntry id="R_EP_Helpdesk_o4"><text>"MS 365; ticketing; remote support; RMM"</text></outputEntry>
        <outputEntry id="R_EP_Helpdesk_o5"><text>"Standard"</text></outputEntry>
      </rule>

      <rule id="R_EP_Programer">
        <inputEntry id="R_EP_Programer_i1"><text>"programer"</text></inputEntry>
        <outputEntry id="R_EP_Programer_o1"><text>"Laptop visoke klase (SSD, 16GB+ RAM)"</text></outputEntry>
        <outputEntry id="R_EP_Programer_o2"><text>3</text></outputEntry>
        <outputEntry id="R_EP_Programer_o3"><text>"Docking; ergonomija"</text></outputEntry>
        <outputEntry id="R_EP_Programer_o4"><text>"IDE (VS Code/JetBrains); Git; Docker; dev alati"</text></outputEntry>
        <outputEntry id="R_EP_Programer_o5"><text>"Standard+"</text></outputEntry>
      </rule>

      <rule id="R_EP_NocSoc">
        <inputEntry id="R_EP_NocSoc_i1"><text>"noc_soc"</text></inputEntry>
        <outputEntry id="R_EP_NocSoc_o1"><text>"Workstation / laptop (viša klasa)"</text></outputEntry>
        <outputEntry id="R_EP_NocSoc_o2"><text>4</text></outputEntry>
        <outputEntry id="R_EP_NocSoc_o3"><text>"Docking; headset"</text></outputEntry>
        <outputEntry id="R_EP_NocSoc_o4"><text>"SIEM; monitoring; mrežni analizatori; VPN"</text></outputEntry>
        <outputEntry id="R_EP_NocSoc_o5"><text>"High"</text></outputEntry>
      </rule>

      <rule id="R_EP_Default">
        <inputEntry id="R_EP_Default_i1"><text>-</text></inputEntry>
        <outputEntry id="R_EP_Default_o1"><text>"Standard laptop"</text></outputEntry>
        <outputEntry id="R_EP_Default_o2"><text>2</text></outputEntry>
        <outputEntry id="R_EP_Default_o3"><text>"Tipkovnica; miš"</text></outputEntry>
        <outputEntry id="R_EP_Default_o4"><text>"MS 365"</text></outputEntry>
        <outputEntry id="R_EP_Default_o5"><text>"Standard"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>

  <!-- ===================== DMN DI (Camunda Modeler 5.x compatible) ===================== -->
  <dmndi:DMNDI>
    <dmndi:DMNDiagram id="DMNDiagram_1" name="JGL IT Hire Decisions">

      <!-- Decisions -->
      <dmndi:DMNShape id="DMNShape_Decision_EvaluateCandidate" dmnElementRef="Decision_EvaluateCandidate">
        <dc:Bounds x="180" y="120" width="220" height="80"/>
      </dmndi:DMNShape>

      <dmndi:DMNShape id="DMNShape_Decision_EquipmentProfile" dmnElementRef="Decision_EquipmentProfile">
        <dc:Bounds x="520" y="120" width="220" height="80"/>
      </dmndi:DMNShape>

      <!-- Inputs -->
      <dmndi:DMNShape id="DMNShape_Input_roleType" dmnElementRef="Input_roleType">
        <dc:Bounds x="360" y="260" width="160" height="60"/>
      </dmndi:DMNShape>

      <dmndi:DMNShape id="DMNShape_Input_hrScreeningPassed" dmnElementRef="Input_hrScreeningPassed">
        <dc:Bounds x="80" y="260" width="220" height="60"/>
      </dmndi:DMNShape>

      <dmndi:DMNShape id="DMNShape_Input_technicalTestScore" dmnElementRef="Input_technicalTestScore">
        <dc:Bounds x="80" y="340" width="220" height="60"/>
      </dmndi:DMNShape>

      <dmndi:DMNShape id="DMNShape_Input_technicalInterviewScore" dmnElementRef="Input_technicalInterviewScore">
        <dc:Bounds x="80" y="420" width="220" height="60"/>
      </dmndi:DMNShape>

      <dmndi:DMNShape id="DMNShape_Input_referenceCheckPassed" dmnElementRef="Input_referenceCheckPassed">
        <dc:Bounds x="80" y="500" width="220" height="60"/>
      </dmndi:DMNShape>

      <dmndi:DMNShape id="DMNShape_Input_seniority" dmnElementRef="Input_seniority">
        <dc:Bounds x="80" y="580" width="220" height="60"/>
      </dmndi:DMNShape>

      <!-- Edges (dmnElementRef points to informationRequirement ids) -->
      <dmndi:DMNEdge id="DMNEdge_IR_EC_roleType" dmnElementRef="IR_EC_roleType">
        <di:waypoint x="440" y="260"/>
        <di:waypoint x="290" y="200"/>
      </dmndi:DMNEdge>

      <dmndi:DMNEdge id="DMNEdge_IR_EC_hr" dmnElementRef="IR_EC_hr">
        <di:waypoint x="190" y="260"/>
        <di:waypoint x="260" y="200"/>
      </dmndi:DMNEdge>

      <dmndi:DMNEdge id="DMNEdge_IR_EC_test" dmnElementRef="IR_EC_test">
        <di:waypoint x="190" y="340"/>
        <di:waypoint x="260" y="200"/>
      </dmndi:DMNEdge>

      <dmndi:DMNEdge id="DMNEdge_IR_EC_interview" dmnElementRef="IR_EC_interview">
        <di:waypoint x="190" y="420"/>
        <di:waypoint x="260" y="200"/>
      </dmndi:DMNEdge>

      <dmndi:DMNEdge id="DMNEdge_IR_EC_ref" dmnElementRef="IR_EC_ref">
        <di:waypoint x="190" y="500"/>
        <di:waypoint x="260" y="200"/>
      </dmndi:DMNEdge>

      <dmndi:DMNEdge id="DMNEdge_IR_EC_seniority" dmnElementRef="IR_EC_seniority">
        <di:waypoint x="190" y="580"/>
        <di:waypoint x="260" y="200"/>
      </dmndi:DMNEdge>

      <dmndi:DMNEdge id="DMNEdge_IR_EP_roleType" dmnElementRef="IR_EP_roleType">
        <di:waypoint x="520" y="260"/>
        <di:waypoint x="630" y="200"/>
      </dmndi:DMNEdge>

    </dmndi:DMNDiagram>
  </dmndi:DMNDI>

</definitions>
