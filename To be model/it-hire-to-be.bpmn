    <bpmn:sequenceFlow id="Flow_12" sourceRef="UT_SendOffer" targetRef="IMC_OfferResp" />
    <bpmn:sequenceFlow id="Flow_1lpiw2a" sourceRef="IMC_OfferResp" targetRef="BE_OfferTimeout" />
    <bpmn:sequenceFlow id="Flow_1jm79nt" sourceRef="BE_OfferTimeout" targetRef="GW_OfferAccepted" />
    <bpmn:sequenceFlow id="Flow_0iq085m" sourceRef="GW_OfferAccepted" targetRef="End_OfferDeclined">
