<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  id="Definitions_JGL_IT_Hire_ToBe"
  targetNamespace="http://jgl.hr/bpmn/it-hire/to-be">

  <bpmn:collaboration id="Collab_IT_Hire">
    <bpmn:participant id="Participant_JGL" name="JGL" processRef="Process_JGL_IT_Hire"/>
    <bpmn:participant id="Participant_Agency" name="Vanjska agencija" processRef="Process_Agency"/>

    <bpmn:messageFlow id="Msg_RequestToAgency" name="Proslijedi oglas / zahtjev" sourceRef="ST_PublishJob" targetRef="Agency_Start"/>
    <bpmn:messageFlow id="Msg_ShortlistToHR" name="Dostavi shortlist" sourceRef="Agency_End_Shortlist" targetRef="IMC_Shortlist"/>
  </bpmn:collaboration>

  <!-- ===================== JGL Process ===================== -->
  <bpmn:process id="Process_JGL_IT_Hire" name="TO-BE: Zapošljavanje IT djelatnika (JGL)" isExecutable="true">

    
    <bpmn:laneSet id="LaneSet_JGL">
      <bpmn:lane id="Lane_HR" name="HR">
        <bpmn:flowNodeRef>ST_ValidateBudget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Budget</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_PublishJob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IMC_Shortlist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_Selection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE_Selection_SLA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_NotifyReject_SLA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_SLA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BRT_EvalCandidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_NotifyReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_GenOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_SendOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IMC_OfferResp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE_OfferTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_RemindOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OfferDeclined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_OfferAccepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_RegisterHR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_RegisterHZMO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_RegisterHZZO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_Contract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG_ParallelStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PG_ParallelJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_OnboardingDay1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_ScheduleCheckins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Timer_Probation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_ProbationEval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_EvalProbationHR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ProbationPass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Pass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Fail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_BudgetReject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ITLead" name="Voditelj IT tima">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UT_Request</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT" name="IT odjel">
        <bpmn:flowNodeRef>ST_ProvisionAD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_CreateM365</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_AssignLic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_CreateAccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_ConfigureDevice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_SecurityConfig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_TestAndRegister</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Procurement" name="Nabava">
        <bpmn:flowNodeRef>BRT_EquipProfile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_CheckInventory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_InStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_ReserveEquip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_OrderEquip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_TrackDelivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_HandoverToIT</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
<bpmn:startEvent id="StartEvent_1" name="Potreba za zapošljavanjem">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="UT_Request" name="Unos zahtjeva (Faza 1)">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_JobRequest"/>
      </bpmn:extensionElements>
    </bpmn:userTask>

    <!-- Service Task: provjera budžeta (Faza 1) -->
    <bpmn:serviceTask id="ST_ValidateBudget" name="Provjeri budžet">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-budget"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="GW_Budget" name="Budžet odobren?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4_yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_4_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="End_BudgetReject" name="Zahtjev odbijen (budžet)">
      <bpmn:incoming>Flow_4_no</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Faza 2: objava natječaja / komunikacija s agencijom -->
    <bpmn:serviceTask id="ST_PublishJob" name="Pošalji oglas agenciji (Faza 2)">
      <bpmn:incoming>Flow_4_yes</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-job-posting"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:intermediateCatchEvent id="IMC_Shortlist" name="Shortlist kandidata zaprimljen">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Shortlist"/>
    </bpmn:intermediateCatchEvent>

    <!-- Faza 3: selekcijski postupak -->
    <bpmn:subProcess id="SP_Selection" name="Faza 3: Selekcijski postupak">
      
      <bpmn:startEvent id="Sel_Start" name="Kandidat u selekciji">
        <bpmn:outgoing>Sel_Flow_1</bpmn:outgoing>
      </bpmn:startEvent>

      <bpmn:userTask id="Sel_HRScreen" name="HR screening intervju">
        <bpmn:incoming>Sel_Flow_1</bpmn:incoming>
        <bpmn:outgoing>Sel_Flow_2</bpmn:outgoing>
        <bpmn:extensionElements>
          <zeebe:formDefinition formId="Form_HRScreening"/>
        </bpmn:extensionElements>
      </bpmn:userTask>

      <bpmn:exclusiveGateway id="Sel_GW_HRPassed" name="HR screening prošao?">
        <bpmn:incoming>Sel_Flow_2</bpmn:incoming>
        <bpmn:outgoing>Sel_Flow_2_yes</bpmn:outgoing>
        <bpmn:outgoing>Sel_Flow_2_no</bpmn:outgoing>
      </bpmn:exclusiveGateway>

      <bpmn:userTask id="Sel_TechTest" name="Tehnički test (unos rezultata)">
        <bpmn:incoming>Sel_Flow_2_yes</bpmn:incoming>
        <bpmn:outgoing>Sel_Flow_3</bpmn:outgoing>
        <bpmn:extensionElements>
          <zeebe:formDefinition formId="Form_TechTest"/>
        </bpmn:extensionElements>
      </bpmn:userTask>

      <bpmn:exclusiveGateway id="Sel_GW_TestPassed" name="Prošao tehnički test?">
        <bpmn:incoming>Sel_Flow_3</bpmn:incoming>
        <bpmn:outgoing>Sel_Flow_3_yes</bpmn:outgoing>
        <bpmn:outgoing>Sel_Flow_3_no</bpmn:outgoing>
      </bpmn:exclusiveGateway>

      <bpmn:userTask id="Sel_TechInterview" name="Tehnički intervju (unos ocjena)">
        <bpmn:incoming>Sel_Flow_3_yes</bpmn:incoming>
        <bpmn:outgoing>Sel_Flow_4</bpmn:outgoing>
        <bpmn:extensionElements>
          <zeebe:formDefinition formId="Form_InterviewScores"/>
        </bpmn:extensionElements>
      </bpmn:userTask>

      <bpmn:exclusiveGateway id="Sel_GW_FinalNeeded" name="Finalni intervju potreban?">
        <bpmn:incoming>Sel_Flow_4</bpmn:incoming>
        <bpmn:outgoing>Sel_Flow_5_yes</bpmn:outgoing>
        <bpmn:outgoing>Sel_Flow_5_no</bpmn:outgoing>
      </bpmn:exclusiveGateway>

      <bpmn:userTask id="Sel_FinalInterview" name="Finalni intervju (menadžment)">
        <bpmn:incoming>Sel_Flow_5_yes</bpmn:incoming>
        <bpmn:outgoing>Sel_Flow_6</bpmn:outgoing>
        <bpmn:extensionElements>
          <zeebe:formDefinition formId="Form_FinalInterview"/>
        </bpmn:extensionElements>
      </bpmn:userTask>

      <bpmn:exclusiveGateway id="Sel_GW_MgmtApproved" name="Odobreno od menadžmenta?">
        <bpmn:incoming>Sel_Flow_6</bpmn:incoming>
        <bpmn:outgoing>Sel_Flow_6_yes</bpmn:outgoing>
        <bpmn:outgoing>Sel_Flow_6_no</bpmn:outgoing>
      </bpmn:exclusiveGateway>

      <bpmn:userTask id="Sel_RefCheck" name="Provjera referenci">
        <bpmn:incoming>Sel_Flow_6_yes</bpmn:incoming>
        <bpmn:incoming>Sel_Flow_5_no</bpmn:incoming>
        <bpmn:outgoing>Sel_Flow_7</bpmn:outgoing>
        <bpmn:extensionElements>
          <zeebe:formDefinition formId="Form_ReferenceCheck"/>
        </bpmn:extensionElements>
      </bpmn:userTask>

      <bpmn:endEvent id="Sel_End" name="Selekcija završena">
        <bpmn:incoming>Sel_Flow_7</bpmn:incoming>
        <bpmn:incoming>Sel_Flow_2_no</bpmn:incoming>
        <bpmn:incoming>Sel_Flow_3_no</bpmn:incoming>
        <bpmn:incoming>Sel_Flow_6_no</bpmn:incoming>
      </bpmn:endEvent>

      <!-- Selection flows -->
      <bpmn:sequenceFlow id="Sel_Flow_1" sourceRef="Sel_Start" targetRef="Sel_HRScreen"/>
      <bpmn:sequenceFlow id="Sel_Flow_2" sourceRef="Sel_HRScreen" targetRef="Sel_GW_HRPassed"/>

      <bpmn:sequenceFlow id="Sel_Flow_2_yes" sourceRef="Sel_GW_HRPassed" targetRef="Sel_TechTest">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= hrScreeningPassed</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Sel_Flow_2_no" sourceRef="Sel_GW_HRPassed" targetRef="Sel_End">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= not(hrScreeningPassed)</bpmn:conditionExpression>
      </bpmn:sequenceFlow>

      <bpmn:sequenceFlow id="Sel_Flow_3" sourceRef="Sel_TechTest" targetRef="Sel_GW_TestPassed"/>
      <bpmn:sequenceFlow id="Sel_Flow_3_yes" sourceRef="Sel_GW_TestPassed" targetRef="Sel_TechInterview">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= techTestPassed</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Sel_Flow_3_no" sourceRef="Sel_GW_TestPassed" targetRef="Sel_End">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= not(techTestPassed)</bpmn:conditionExpression>
      </bpmn:sequenceFlow>

      <bpmn:sequenceFlow id="Sel_Flow_4" sourceRef="Sel_TechInterview" targetRef="Sel_GW_FinalNeeded"/>
      <bpmn:sequenceFlow id="Sel_Flow_5_yes" sourceRef="Sel_GW_FinalNeeded" targetRef="Sel_FinalInterview">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= needsFinalInterview</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Sel_Flow_5_no" sourceRef="Sel_GW_FinalNeeded" targetRef="Sel_RefCheck">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= not(needsFinalInterview)</bpmn:conditionExpression>
      </bpmn:sequenceFlow>

      <bpmn:sequenceFlow id="Sel_Flow_6" sourceRef="Sel_FinalInterview" targetRef="Sel_GW_MgmtApproved"/>
      <bpmn:sequenceFlow id="Sel_Flow_6_yes" sourceRef="Sel_GW_MgmtApproved" targetRef="Sel_RefCheck">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= managementApproval</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Sel_Flow_6_no" sourceRef="Sel_GW_MgmtApproved" targetRef="Sel_End">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= not(managementApproval)</bpmn:conditionExpression>
      </bpmn:sequenceFlow>

      <bpmn:sequenceFlow id="Sel_Flow_7" sourceRef="Sel_RefCheck" targetRef="Sel_End"/>



    </bpmn:subProcess>

    <!-- SLA: 14 dana za selekciju (7-14 dana iz dokumenta) -->
    <bpmn:boundaryEvent id="BE_Selection_SLA" name="SLA selekcije (14d)" attachedToRef="SP_Selection" cancelActivity="true">
      <bpmn:outgoing>Flow_Selection_SLA</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>


    <bpmn:serviceTask id="ST_NotifyReject_SLA" name="Obavijesti o prekoračenju SLA">
      <bpmn:incoming>Flow_Selection_SLA</bpmn:incoming>
      <bpmn:outgoing>Flow_Selection_SLA_2</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-sla-breach"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_SLA" name="Prekid (SLA selekcije)">
      <bpmn:incoming>Flow_Selection_SLA_2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:businessRuleTask id="BRT_EvalCandidate" name="Evaluiraj kandidata (DMN)">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="Decision_EvaluateCandidate" resultVariable="candidateEvaluation"/>
      </bpmn:extensionElements>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="GW_Offer" name="Odluka">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9_offer</bpmn:outgoing>
      <bpmn:outgoing>Flow_9_reject</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="ST_NotifyReject" name="Obavijesti neodabrane kandidate">
      <bpmn:incoming>Flow_9_reject</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-rejected-candidate"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_Rejected" name="Proces završen (odbijen kandidat)">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Faza 4: ponuda -->
    <bpmn:serviceTask id="ST_GenOffer" name="Generiraj ponudu (PDF)">
      <bpmn:incoming>Flow_9_offer</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="generate-offer-pdf"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:userTask id="UT_SendOffer" name="Slanje ponude (Faza 4)">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_SendOffer"/>
      </bpmn:extensionElements>
    </bpmn:userTask>

    <!-- čekanje odgovora; timeout 5 dana -->
    <bpmn:intermediateCatchEvent id="IMC_OfferResp" name="Odgovor na ponudu">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_OfferResponse"/>
    </bpmn:intermediateCatchEvent>

    <bpmn:boundaryEvent id="BE_OfferTimeout" name="Rok odgovora (5d)" attachedToRef="IMC_OfferResp" cancelActivity="true">
      <bpmn:outgoing>Flow_OfferTimeout</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:serviceTask id="ST_RemindOffer" name="Pošalji podsjetnik kandidatu">
      <bpmn:incoming>Flow_OfferTimeout</bpmn:incoming>
      <bpmn:outgoing>Flow_RemindOffer_2</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-offer-reminder-email"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_OfferDeclined" name="Ponuda odbijena/istekao rok">
      <bpmn:incoming>Flow_RemindOffer_2</bpmn:incoming>
      <bpmn:incoming>Flow_14_no</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:exclusiveGateway id="GW_OfferAccepted" name="Ponuda prihvaćena?">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14_yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_14_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Faza 5: administrativna priprema -->
    <bpmn:serviceTask id="ST_RegisterHR" name="Upis u HR sustav (Faza 5)">
      <bpmn:incoming>Flow_14_yes</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="register-employee-hr-system"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ST_RegisterHZMO" name="Prijava na HZMO">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="register-hzmo"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ST_RegisterHZZO" name="Prijava na HZZO">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="register-hzzo"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:userTask id="UT_Contract" name="Potpis ugovora (Faza 5)">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_ContractSignature"/>
      </bpmn:extensionElements>
    </bpmn:userTask>

    <!-- Faza 6: paralelno IT + nabava -->
    <bpmn:parallelGateway id="PG_ParallelStart" name="Paralelno: IT + Nabava">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_IT_1</bpmn:outgoing>
      <bpmn:outgoing>Flow_PR_1</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Nabava grana -->
    <bpmn:businessRuleTask id="BRT_EquipProfile" name="Profil opreme (DMN)">
      <bpmn:incoming>Flow_PR_1</bpmn:incoming>
      <bpmn:outgoing>Flow_PR_2</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="Decision_EquipmentProfile" resultVariable="equipmentProfile"/>
      </bpmn:extensionElements>
    </bpmn:businessRuleTask>

    <bpmn:serviceTask id="ST_CheckInventory" name="Provjeri zalihu opreme">
      <bpmn:incoming>Flow_PR_2</bpmn:incoming>
      <bpmn:outgoing>Flow_PR_3</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-inventory"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="GW_InStock" name="Oprema na zalihi?">
      <bpmn:incoming>Flow_PR_3</bpmn:incoming>
      <bpmn:outgoing>Flow_PR_4_yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_PR_4_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="ST_ReserveEquip" name="Rezerviraj opremu">
      <bpmn:incoming>Flow_PR_4_yes</bpmn:incoming>
      <bpmn:outgoing>Flow_PR_5a</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reserve-equipment"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ST_OrderEquip" name="Naruči opremu">
      <bpmn:incoming>Flow_PR_4_no</bpmn:incoming>
      <bpmn:outgoing>Flow_PR_5b</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="order-equipment"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ST_TrackDelivery" name="Prati isporuku / zaprimanje">
      <bpmn:incoming>Flow_PR_5a</bpmn:incoming>
      <bpmn:incoming>Flow_PR_5b</bpmn:incoming>
      <bpmn:outgoing>Flow_PR_6</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="track-delivery"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ST_HandoverToIT" name="Predaj opremu IT-u">
      <bpmn:incoming>Flow_PR_6</bpmn:incoming>
      <bpmn:outgoing>Flow_PR_7</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="handover-equipment-to-it"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <!-- IT grana -->
    <bpmn:serviceTask id="ST_ProvisionAD" name="Kreiraj AD račun">
      <bpmn:incoming>Flow_IT_1</bpmn:incoming>
      <bpmn:outgoing>Flow_IT_2</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="provision-ad-account"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ST_CreateM365" name="Kreiraj M365/Email račun">
      <bpmn:incoming>Flow_IT_2</bpmn:incoming>
      <bpmn:outgoing>Flow_IT_3</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="create-m365-account"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ST_AssignLic" name="Dodijeli licence">
      <bpmn:incoming>Flow_IT_3</bpmn:incoming>
      <bpmn:outgoing>Flow_IT_4</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="assign-licenses"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ST_CreateAccess" name="Dodijeli pristupe (VPN/ticketing/dok.)">
      <bpmn:incoming>Flow_IT_4</bpmn:incoming>
      <bpmn:outgoing>Flow_IT_5</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="create-internal-access"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ST_ConfigureDevice" name="Konfiguriraj uređaj (OS/MDM/software)">
      <bpmn:incoming>Flow_IT_5</bpmn:incoming>
      <bpmn:outgoing>Flow_IT_6</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="configure-device"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ST_SecurityConfig" name="Sigurnosne postavke (BitLocker/EDR/Firewall)">
      <bpmn:incoming>Flow_IT_6</bpmn:incoming>
      <bpmn:outgoing>Flow_IT_7</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="configure-security"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="ST_TestAndRegister" name="Testiraj i registriraj opremu">
      <bpmn:incoming>Flow_IT_7</bpmn:incoming>
      <bpmn:outgoing>Flow_IT_8</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="test-and-register-asset"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:parallelGateway id="PG_ParallelJoin" name="Spajanje grana">
      <bpmn:incoming>Flow_IT_8</bpmn:incoming>
      <bpmn:incoming>Flow_PR_7</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:parallelGateway>

    <!-- Faza 7: onboarding + probni rad -->
    <bpmn:userTask id="UT_OnboardingDay1" name="Onboarding: prvi dan (Faza 7)">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_OnboardingDay1"/>
      </bpmn:extensionElements>
    </bpmn:userTask>

    <bpmn:serviceTask id="ST_ScheduleCheckins" name="Planiraj check-in sastanke">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="schedule-checkins"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:intermediateCatchEvent id="Timer_Probation" name="Kraj probnog rada (3 mjeseca)">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="UT_ProbationEval" name="Evaluacija probnog rada">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="Form_ProbationEvaluation"/>
      </bpmn:extensionElements>
    </bpmn:userTask>

    <bpmn:serviceTask id="ST_EvalProbationHR" name="Zapiši evaluaciju u HR sustav">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="evaluate-probation-hr-system"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="GW_ProbationPass" name="Prošao probni rad?">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25_pass</bpmn:outgoing>
      <bpmn:outgoing>Flow_25_fail</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="End_Pass" name="Kraj: nastavak zaposlenja">
      <bpmn:incoming>Flow_25_pass</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="End_Fail" name="Kraj: raskid ugovora">
      <bpmn:incoming>Flow_25_fail</bpmn:incoming>
    </bpmn:endEvent>

    <!-- Main process sequence flows -->
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="UT_Request"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="UT_Request" targetRef="ST_ValidateBudget"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="ST_ValidateBudget" targetRef="GW_Budget"/>
    <bpmn:sequenceFlow id="Flow_4_yes" sourceRef="GW_Budget" targetRef="ST_PublishJob">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= budgetApproved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4_no" sourceRef="GW_Budget" targetRef="End_BudgetReject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= not(budgetApproved)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="ST_PublishJob" targetRef="IMC_Shortlist"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="IMC_Shortlist" targetRef="SP_Selection"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="SP_Selection" targetRef="BRT_EvalCandidate"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="BRT_EvalCandidate" targetRef="GW_Offer"/>
    <bpmn:sequenceFlow id="Flow_9_offer" sourceRef="GW_Offer" targetRef="ST_GenOffer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= candidateEvaluation.result = "Offer"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9_reject" sourceRef="GW_Offer" targetRef="ST_NotifyReject">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= candidateEvaluation.result = "Reject"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="ST_NotifyReject" targetRef="End_Rejected"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="ST_GenOffer" targetRef="UT_SendOffer"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="UT_SendOffer" targetRef="IMC_OfferResp"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="IMC_OfferResp" targetRef="GW_OfferAccepted"/>
    <bpmn:sequenceFlow id="Flow_14_yes" sourceRef="GW_OfferAccepted" targetRef="ST_RegisterHR">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= offerAccepted</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14_no" sourceRef="GW_OfferAccepted" targetRef="End_OfferDeclined">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= not(offerAccepted)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="ST_RegisterHR" targetRef="ST_RegisterHZMO"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="ST_RegisterHZMO" targetRef="ST_RegisterHZZO"/>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="ST_RegisterHZZO" targetRef="UT_Contract"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="UT_Contract" targetRef="PG_ParallelStart"/>

    <bpmn:sequenceFlow id="Flow_IT_1" sourceRef="PG_ParallelStart" targetRef="ST_ProvisionAD"/>
    <bpmn:sequenceFlow id="Flow_IT_2" sourceRef="ST_ProvisionAD" targetRef="ST_CreateM365"/>
    <bpmn:sequenceFlow id="Flow_IT_3" sourceRef="ST_CreateM365" targetRef="ST_AssignLic"/>
    <bpmn:sequenceFlow id="Flow_IT_4" sourceRef="ST_AssignLic" targetRef="ST_CreateAccess"/>
    <bpmn:sequenceFlow id="Flow_IT_5" sourceRef="ST_CreateAccess" targetRef="ST_ConfigureDevice"/>
    <bpmn:sequenceFlow id="Flow_IT_6" sourceRef="ST_ConfigureDevice" targetRef="ST_SecurityConfig"/>
    <bpmn:sequenceFlow id="Flow_IT_7" sourceRef="ST_SecurityConfig" targetRef="ST_TestAndRegister"/>
    <bpmn:sequenceFlow id="Flow_IT_8" sourceRef="ST_TestAndRegister" targetRef="PG_ParallelJoin"/>

    <bpmn:sequenceFlow id="Flow_PR_1" sourceRef="PG_ParallelStart" targetRef="BRT_EquipProfile"/>
    <bpmn:sequenceFlow id="Flow_PR_2" sourceRef="BRT_EquipProfile" targetRef="ST_CheckInventory"/>
    <bpmn:sequenceFlow id="Flow_PR_3" sourceRef="ST_CheckInventory" targetRef="GW_InStock"/>
    <bpmn:sequenceFlow id="Flow_PR_4_yes" sourceRef="GW_InStock" targetRef="ST_ReserveEquip">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= inventoryAvailable</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PR_4_no" sourceRef="GW_InStock" targetRef="ST_OrderEquip">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= not(inventoryAvailable)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PR_5a" sourceRef="ST_ReserveEquip" targetRef="ST_TrackDelivery"/>
    <bpmn:sequenceFlow id="Flow_PR_5b" sourceRef="ST_OrderEquip" targetRef="ST_TrackDelivery"/>
    <bpmn:sequenceFlow id="Flow_PR_6" sourceRef="ST_TrackDelivery" targetRef="ST_HandoverToIT"/>
    <bpmn:sequenceFlow id="Flow_PR_7" sourceRef="ST_HandoverToIT" targetRef="PG_ParallelJoin"/>

    <bpmn:sequenceFlow id="Flow_19" sourceRef="PG_ParallelJoin" targetRef="UT_OnboardingDay1"/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="UT_OnboardingDay1" targetRef="ST_ScheduleCheckins"/>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="ST_ScheduleCheckins" targetRef="Timer_Probation"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Timer_Probation" targetRef="UT_ProbationEval"/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="UT_ProbationEval" targetRef="ST_EvalProbationHR"/>
    <bpmn:sequenceFlow id="Flow_24" sourceRef="ST_EvalProbationHR" targetRef="GW_ProbationPass"/>
    <bpmn:sequenceFlow id="Flow_25_pass" sourceRef="GW_ProbationPass" targetRef="End_Pass">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= probationPassed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_25_fail" sourceRef="GW_ProbationPass" targetRef="End_Fail">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= not(probationPassed)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Selection_SLA" sourceRef="BE_Selection_SLA" targetRef="ST_NotifyReject_SLA"/>
    <bpmn:sequenceFlow id="Flow_Selection_SLA_2" sourceRef="ST_NotifyReject_SLA" targetRef="End_SLA"/>

    <bpmn:sequenceFlow id="Flow_OfferTimeout" sourceRef="BE_OfferTimeout" targetRef="ST_RemindOffer"/>
    <bpmn:sequenceFlow id="Flow_RemindOffer_2" sourceRef="ST_RemindOffer" targetRef="End_OfferDeclined"/>

  </bpmn:process>

  <!-- ===================== Agency Process ===================== -->
  <bpmn:process id="Process_Agency" name="Vanjska agencija (TO-BE)" isExecutable="false">

    <bpmn:startEvent id="Agency_Start" name="Zaprimljen zahtjev/oglas">
      <bpmn:outgoing>Agency_Flow_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Agency_Msg_In"/>
    </bpmn:startEvent>

    <bpmn:task id="Agency_Task_Sourcing" name="Objava + active sourcing + shortlist">
      <bpmn:incoming>Agency_Flow_1</bpmn:incoming>
      <bpmn:outgoing>Agency_Flow_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="Agency_End_Shortlist" name="Shortlist poslan HR-u">
      <bpmn:incoming>Agency_Flow_2</bpmn:incoming>
      <bpmn:messageEventDefinition id="Agency_Msg_Out"/>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Agency_Flow_1" sourceRef="Agency_Start" targetRef="Agency_Task_Sourcing"/>
    <bpmn:sequenceFlow id="Agency_Flow_2" sourceRef="Agency_Task_Sourcing" targetRef="Agency_End_Shortlist"/>

  </bpmn:process>

  <!-- ===================== BPMN DI ===================== -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1" name="TO-BE IT Hire (JGL)">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collab_IT_Hire">

      
      <!-- Pools -->
      <bpmndi:BPMNShape id="DI_Participant_JGL" bpmnElement="Participant_JGL" isHorizontal="true">
        <dc:Bounds x="80" y="160" width="6700" height="620"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Participant_Agency" bpmnElement="Participant_Agency" isHorizontal="true">
        <dc:Bounds x="80" y="40" width="1100" height="120"/>
      </bpmndi:BPMNShape>

      <!-- Lanes (inside JGL pool) -->
      <bpmndi:BPMNShape id="DI_Lane_HR" bpmnElement="Lane_HR" isHorizontal="true">
        <dc:Bounds x="110" y="160" width="6670" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Lane_ITLead" bpmnElement="Lane_ITLead" isHorizontal="true">
        <dc:Bounds x="110" y="320" width="6670" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Lane_IT" bpmnElement="Lane_IT" isHorizontal="true">
        <dc:Bounds x="110" y="480" width="6670" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Lane_Procurement" bpmnElement="Lane_Procurement" isHorizontal="true">
        <dc:Bounds x="110" y="640" width="6670" height="140"/>
      </bpmndi:BPMNShape>

<bpmndi:BPMNShape id="DI_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds x="120" y="360" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_UT_Request" bpmnElement="UT_Request">
        <dc:Bounds x="200" y="340" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_ST_ValidateBudget" bpmnElement="ST_ValidateBudget">
        <dc:Bounds x="380" y="180" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_GW_Budget" bpmnElement="GW_Budget">
        <dc:Bounds x="580" y="200" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_End_BudgetReject" bpmnElement="End_BudgetReject">
        <dc:Bounds x="720" y="210" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_ST_PublishJob" bpmnElement="ST_PublishJob">
        <dc:Bounds x="720" y="180" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_IMC_Shortlist" bpmnElement="IMC_Shortlist">
        <dc:Bounds x="940" y="210" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_SP_Selection" bpmnElement="SP_Selection">
        <dc:Bounds x="1020" y="110" width="420" height="240"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_BRT_EvalCandidate" bpmnElement="BRT_EvalCandidate">
        <dc:Bounds x="1460" y="180" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_GW_Offer" bpmnElement="GW_Offer">
        <dc:Bounds x="1680" y="200" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_ST_NotifyReject" bpmnElement="ST_NotifyReject">
        <dc:Bounds x="1820" y="180" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_End_Rejected" bpmnElement="End_Rejected">
        <dc:Bounds x="2020" y="210" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_ST_GenOffer" bpmnElement="ST_GenOffer">
        <dc:Bounds x="1820" y="290" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_UT_SendOffer" bpmnElement="UT_SendOffer">
        <dc:Bounds x="2020" y="290" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_IMC_OfferResp" bpmnElement="IMC_OfferResp">
        <dc:Bounds x="2220" y="320" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_BE_OfferTimeout" bpmnElement="BE_OfferTimeout">
        <dc:Bounds x="2100" y="260" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_ST_RemindOffer" bpmnElement="ST_RemindOffer">
        <dc:Bounds x="2320" y="290" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_GW_OfferAccepted" bpmnElement="GW_OfferAccepted">
        <dc:Bounds x="2520" y="320" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_End_OfferDeclined" bpmnElement="End_OfferDeclined">
        <dc:Bounds x="2670" y="330" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_ST_RegisterHR" bpmnElement="ST_RegisterHR">
        <dc:Bounds x="2720" y="180" width="190" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_ST_RegisterHZMO" bpmnElement="ST_RegisterHZMO">
        <dc:Bounds x="2940" y="180" width="190" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_ST_RegisterHZZO" bpmnElement="ST_RegisterHZZO">
        <dc:Bounds x="3160" y="180" width="190" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_UT_Contract" bpmnElement="UT_Contract">
        <dc:Bounds x="3380" y="180" width="170" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_PG_ParallelStart" bpmnElement="PG_ParallelStart">
        <dc:Bounds x="3620" y="200" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_BRT_EquipProfile" bpmnElement="BRT_EquipProfile">
        <dc:Bounds x="3740" y="660" width="190" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_ST_CheckInventory" bpmnElement="ST_CheckInventory">
        <dc:Bounds x="3960" y="660" width="190" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_GW_InStock" bpmnElement="GW_InStock">
        <dc:Bounds x="4180" y="680" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_ST_ReserveEquip" bpmnElement="ST_ReserveEquip">
        <dc:Bounds x="4320" y="620" width="190" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_ST_OrderEquip" bpmnElement="ST_OrderEquip">
        <dc:Bounds x="4320" y="720" width="190" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_ST_TrackDelivery" bpmnElement="ST_TrackDelivery">
        <dc:Bounds x="4540" y="660" width="190" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_ST_HandoverToIT" bpmnElement="ST_HandoverToIT">
        <dc:Bounds x="4760" y="660" width="190" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_ST_ProvisionAD" bpmnElement="ST_ProvisionAD">
        <dc:Bounds x="3740" y="460" width="190" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_ST_CreateM365" bpmnElement="ST_CreateM365">
        <dc:Bounds x="3960" y="460" width="190" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_ST_AssignLic" bpmnElement="ST_AssignLic">
        <dc:Bounds x="4180" y="460" width="190" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_ST_CreateAccess" bpmnElement="ST_CreateAccess">
        <dc:Bounds x="4400" y="460" width="190" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_ST_ConfigureDevice" bpmnElement="ST_ConfigureDevice">
        <dc:Bounds x="4620" y="460" width="190" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_ST_SecurityConfig" bpmnElement="ST_SecurityConfig">
        <dc:Bounds x="4840" y="460" width="190" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_ST_TestAndRegister" bpmnElement="ST_TestAndRegister">
        <dc:Bounds x="5060" y="460" width="210" height="80"/>
      </bpmndi:BPMNShape>
