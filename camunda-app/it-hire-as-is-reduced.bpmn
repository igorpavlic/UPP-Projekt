<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Defs_AsIs_Reduced" targetNamespace="http://jgl.hr/process/it-hire/as-is-reduced" exporter="Camunda Modeler" exporterVersion="5.40.1">
  <bpmn:process id="AsIs_ITHire_Reduced" name="Zapošljavanje IT djelatnika — As-Is (reduciran)" isExecutable="true">
    <bpmn:startEvent id="Start" name="IT voditelj identificira potrebu">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UT_DefineNeed" name="Definiranje zahtjeva za zapošljavanje">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="AsIs_Form_JobRequest" />
      </bpmn:extensionElements>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UT_Approval" name="Odobrenje zahtjeva (Uprava)">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="AsIs_Form_BudgetApproval" />
      </bpmn:extensionElements>
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Approved" name="Odobreno?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4_yes</bpmn:outgoing>
      <bpmn:outgoing>F4_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_NotApproved" name="Zahtjev odbijen">
      <bpmn:incoming>F4_no</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ST_NotifyAgency" name="Obavijesti vanjsku agenciju (email)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-agency-notification" />
      </bpmn:extensionElements>
      <bpmn:incoming>F4_yes</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Timer_WaitShortlist" name="Čekanje shortliste (14 dana)">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Shortlist">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="UT_HRScreening" name="HR screening intervju">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="AsIs_Form_HRScreening" />
      </bpmn:extensionElements>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_HRPass" name="Prolazi HR screening?">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8_yes</bpmn:outgoing>
      <bpmn:outgoing>F8_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Rejected" name="Kandidat odbijen">
      <bpmn:incoming>F8_no</bpmn:incoming>
      <bpmn:incoming>F10_no</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UT_TechInterview" name="Tehnički intervju (IT voditelj)">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="AsIs_Form_TechInterview" />
      </bpmn:extensionElements>
      <bpmn:incoming>F8_yes</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_TechPass" name="Prolazi tehnički intervju?">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10_yes</bpmn:outgoing>
      <bpmn:outgoing>F10_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UT_PrepareOffer" name="Priprema i slanje ponude">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="AsIs_Form_Offer" />
      </bpmn:extensionElements>
      <bpmn:incoming>F10_yes</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Timer_WaitResponse" name="Čekanje odgovora kandidata (5 dana)">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_Response">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT20S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="UT_CandidateResponse" name="Unos odgovora kandidata">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="AsIs_Form_CandidateResponse" />
      </bpmn:extensionElements>
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Accepted" name="Kandidat prihvaća?">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14_yes</bpmn:outgoing>
      <bpmn:outgoing>F14_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Declined" name="Ponuda odbijena">
      <bpmn:incoming>F14_no</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="PG_Split" name="Paralelna priprema">
      <bpmn:incoming>F14_yes</bpmn:incoming>
      <bpmn:outgoing>F15_IT</bpmn:outgoing>
      <bpmn:outgoing>F15_Proc</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="UT_PrepareIT" name="IT priprema: računi, laptop, pristupi">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="AsIs_Form_ITPrepare" />
      </bpmn:extensionElements>
      <bpmn:incoming>F15_IT</bpmn:incoming>
      <bpmn:outgoing>F16_IT</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UT_OrderEquipment" name="Nabava: narudžba i isporuka opreme">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="AsIs_Form_Equipment" />
      </bpmn:extensionElements>
      <bpmn:incoming>F15_Proc</bpmn:incoming>
      <bpmn:outgoing>F16_Proc</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="PG_Join" name="Spajanje">
      <bpmn:incoming>F16_IT</bpmn:incoming>
      <bpmn:incoming>F16_Proc</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="UT_Onboarding" name="Onboarding — prvi dan">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="AsIs_Form_Onboarding" />
      </bpmn:extensionElements>
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UT_ProbationEval" name="Evaluacija probnog rada">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="AsIs_Form_ProbationEval" />
      </bpmn:extensionElements>
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Probation" name="Probni rad uspješan?">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20_yes</bpmn:outgoing>
      <bpmn:outgoing>F20_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Hired" name="Uspješno zaposlenje">
      <bpmn:incoming>F20_yes</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_ProbationFail" name="Raskid ugovora">
      <bpmn:incoming>F20_no</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="UT_DefineNeed" />
    <bpmn:sequenceFlow id="F2" sourceRef="UT_DefineNeed" targetRef="UT_Approval" />
    <bpmn:sequenceFlow id="F3" sourceRef="UT_Approval" targetRef="GW_Approved" />
    <bpmn:sequenceFlow id="F4_yes" name="Da" sourceRef="GW_Approved" targetRef="ST_NotifyAgency">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F4_no" name="Ne" sourceRef="GW_Approved" targetRef="End_NotApproved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F5" sourceRef="ST_NotifyAgency" targetRef="Timer_WaitShortlist" />
    <bpmn:sequenceFlow id="F6" sourceRef="Timer_WaitShortlist" targetRef="UT_HRScreening" />
    <bpmn:sequenceFlow id="F7" sourceRef="UT_HRScreening" targetRef="GW_HRPass" />
    <bpmn:sequenceFlow id="F8_yes" name="Da" sourceRef="GW_HRPass" targetRef="UT_TechInterview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=hrScreeningPassed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F8_no" name="Ne" sourceRef="GW_HRPass" targetRef="End_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=hrScreeningPassed = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F9" sourceRef="UT_TechInterview" targetRef="GW_TechPass" />
    <bpmn:sequenceFlow id="F10_yes" name="Da" sourceRef="GW_TechPass" targetRef="UT_PrepareOffer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=techInterviewPassed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F10_no" name="Ne" sourceRef="GW_TechPass" targetRef="End_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=techInterviewPassed = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F11" sourceRef="UT_PrepareOffer" targetRef="Timer_WaitResponse" />
    <bpmn:sequenceFlow id="F12" sourceRef="Timer_WaitResponse" targetRef="UT_CandidateResponse" />
    <bpmn:sequenceFlow id="F13" sourceRef="UT_CandidateResponse" targetRef="GW_Accepted" />
    <bpmn:sequenceFlow id="F14_yes" name="Da" sourceRef="GW_Accepted" targetRef="PG_Split">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=offerAccepted = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F14_no" name="Ne" sourceRef="GW_Accepted" targetRef="End_Declined">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=offerAccepted = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F15_IT" sourceRef="PG_Split" targetRef="UT_PrepareIT" />
    <bpmn:sequenceFlow id="F15_Proc" sourceRef="PG_Split" targetRef="UT_OrderEquipment" />
    <bpmn:sequenceFlow id="F16_IT" sourceRef="UT_PrepareIT" targetRef="PG_Join" />
    <bpmn:sequenceFlow id="F16_Proc" sourceRef="UT_OrderEquipment" targetRef="PG_Join" />
    <bpmn:sequenceFlow id="F17" sourceRef="PG_Join" targetRef="UT_Onboarding" />
    <bpmn:sequenceFlow id="F18" sourceRef="UT_Onboarding" targetRef="UT_ProbationEval" />
    <bpmn:sequenceFlow id="F19" sourceRef="UT_ProbationEval" targetRef="GW_Probation" />
    <bpmn:sequenceFlow id="F20_yes" name="Da" sourceRef="GW_Probation" targetRef="End_Hired">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=probationPassed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F20_no" name="Ne" sourceRef="GW_Probation" targetRef="End_ProbationFail">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=probationPassed = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="AsIs_ITHire_Reduced">
