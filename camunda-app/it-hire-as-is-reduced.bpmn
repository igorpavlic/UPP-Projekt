      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F2" bpmnElement="F2">
        <di:waypoint x="370" y="220" />
        <di:waypoint x="420" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F3" bpmnElement="F3">
        <di:waypoint x="520" y="220" />
        <di:waypoint x="575" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F4_yes" bpmnElement="F4_yes">
        <di:waypoint x="625" y="220" />
        <di:waypoint x="680" y="220" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="645" y="195" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F4_no" bpmnElement="F4_no">
        <di:waypoint x="600" y="195" />
        <di:waypoint x="600" y="138" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="608" y="157" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F5" bpmnElement="F5">
        <di:waypoint x="780" y="220" />
        <di:waypoint x="832" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F6" bpmnElement="F6">
        <di:waypoint x="868" y="220" />
        <di:waypoint x="920" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F7" bpmnElement="F7">
        <di:waypoint x="1020" y="220" />
        <di:waypoint x="1075" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F8_yes" bpmnElement="F8_yes">
        <di:waypoint x="1125" y="220" />
