{
  "schemaVersion": 10,
  "id": "Form_ProcurementReserveOrder",
  "type": "default",
  "name": "Nabava / rezervacija opreme",
  "components": [
    {
      "type": "select",
      "key": "roleType",
      "label": "Tip pozicije",
      "description": "Odaberi tip IT pozicije.",
      "values": [
        {
          "label": "Helpdesk tehničar",
          "value": "helpdesk tehničar"
        },
        {
          "label": "Specijalist poslovnih aplikacija",
          "value": "specijalist poslovnih aplikacija"
        },
        {
          "label": "Specijalist SOC/NOC",
          "value": "specijalist SOC/noc"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
      "type": "text",
      "key": "equipmentProfile.laptopClass",
      "label": "Klasa laptopa (iz DMN)",
      "description": "Automatski popunjeno iz DMN-a (po potrebi ručno).",
      "validate": {
        "required": false
      }
    },
    {
      "type": "number",
      "key": "equipmentProfile.extraMonitors",
      "label": "Broj dodatnih monitora (iz DMN)",
      "validate": {
        "required": false,
        "min": 0,
        "max": 4
      }
    },
    {
      "type": "text",
      "key": "equipmentProfile.securityTools",
      "label": "Sigurnosni alati (iz DMN)",
      "validate": {
        "required": false
      }
    },
    {
      "type": "select",
      "key": "procurementAction",
      "label": "Akcija",
      "values": [
        {
          "label": "Rezerviraj iz zalihe",
          "value": "reserve"
        },
        {
          "label": "Pokreni nabavu",
          "value": "order"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
      "type": "text",
      "key": "assetTagOrRequestRef",
      "label": "Asset tag / referenca zahtjeva",
      "validate": {
        "required": false
      }
    },
    {
      "type": "text",
      "key": "supplierPreferred",
      "label": "Preferirani dobavljač",
      "validate": {
        "required": false
      }
    },
    {
      "type": "number",
      "key": "estimatedCost",
      "label": "Procijenjeni trošak (EUR)",
      "validate": {
        "required": false,
        "min": 0
      }
    },
    {
      "type": "textarea",
      "key": "procurementNotes",
      "label": "Napomene nabave",
      "validate": {
        "required": false
      }
    }
  ]
}