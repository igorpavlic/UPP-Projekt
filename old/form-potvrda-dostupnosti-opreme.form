{
  "schemaVersion": 10,
  "id": "Form_EquipmentAvailability",
  "type": "default",
  "name": "Potvrda dostupnosti opreme",
  "components": [
    {
      "type": "select",
      "key": "roleType",
      "label": "Tip pozicije",
      "description": "Odaberi tip IT pozicije.",
      "values": [
        {
          "label": "Helpdesk tehničar",
          "value": "helpdesk tehničar"
        },
        {
          "label": "Specijalist poslovnih aplikacija",
          "value": "specijalist poslovnih aplikacija"
        },
        {
          "label": "Specijalist SOC/NOC",
          "value": "specijalist SOC/noc"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
      "type": "checkbox",
      "key": "equipmentAvailable",
      "label": "Oprema dostupna na zalihi",
      "defaultValue": false,
      "validate": {
        "required": true
      }
    },
    {
      "type": "text",
      "key": "stockLocation",
      "label": "Lokacija zalihe / skladište",
      "validate": {
        "required": false
      }
    },
    {
      "type": "text",
      "key": "reservedAssetTag",
      "label": "Rezervirani asset tag (ako dostupno)",
      "validate": {
        "required": false
      }
    },
    {
      "type": "date",
      "key": "expectedDeliveryDate",
      "label": "Očekivani datum isporuke (ako nije dostupno)",
      "validate": {
        "required": false
      }
    },
    {
      "type": "textarea",
      "key": "availabilityNotes",
      "label": "Napomena",
      "validate": {
        "required": false
      }
    }
  ]
}