{
  "schemaVersion": 10,
  "id": "Form_JobRequest",
  "type": "default",
  "name": "Unos zahtjeva",
  "components": [
    {
      "type": "text",
      "key": "requestId",
      "label": "ID zahtjeva",
      "description": "Interni identifikator (ako ga već imate).",
      "validate": {
        "required": false
      }
    },
    {
      "type": "text",
      "key": "requester",
      "label": "Podnositelj zahtjeva",
      "validate": {
        "required": true
      }
    },
    {
      "type": "text",
      "key": "costCenter",
      "label": "Troškovno mjesto",
      "validate": {
        "required": false
      }
    },
    {
      "type": "select",
      "key": "roleType",
      "label": "Tip pozicije",
      "description": "Odaberi tip IT pozicije.",
      "values": [
        {
          "label": "Helpdesk tehničar",
          "value": "helpdesk tehničar"
        },
        {
          "label": "Specijalist poslovnih aplikacija",
          "value": "specijalist poslovnih aplikacija"
        },
        {
          "label": "Specijalist SOC/NOC",
          "value": "specijalist SOC/noc"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
      "type": "select",
      "key": "seniority",
      "label": "Razina",
      "values": [
        {
          "label": "Junior",
          "value": "junior"
        },
        {
          "label": "Mid",
          "value": "mid"
        },
        {
          "label": "Senior",
          "value": "senior"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
      "type": "select",
      "key": "employmentType",
      "label": "Vrsta zaposlenja",
      "values": [
        {
          "label": "Neodređeno",
          "value": "indefinite"
        },
        {
          "label": "Određeno",
          "value": "fixed-term"
        },
        {
          "label": "Student/Praksa",
          "value": "intern"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
      "type": "date",
      "key": "desiredStartDate",
      "label": "Željeni datum početka",
      "validate": {
        "required": true
      }
    },
    {
      "type": "textarea",
      "key": "justification",
      "label": "Obrazloženje potrebe",
      "validate": {
        "required": true
      }
    },
    {
      "type": "number",
      "key": "headcount",
      "label": "Broj pozicija",
      "defaultValue": 1,
      "validate": {
        "required": true,
        "min": 1
      }
    },
    {
      "type": "select",
      "key": "recruitmentChannel",
      "label": "Kanal regrutiranja",
      "values": [
        {
          "label": "Vanjska agencija",
          "value": "agency"
        },
        {
          "label": "Direktno (JGL)",
          "value": "direct"
        },
        {
          "label": "Interni transfer",
          "value": "internal"
        }
      ],
      "validate": {
        "required": true
      }
    },
    {
      "type": "checkbox",
      "key": "approved",
      "label": "Odobreno (uprava/IT voditelj)",
      "description": "Ako je ovo task za odobrenje, označi odobreno.",
      "defaultValue": false
    }
  ]
}